    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "@typescript-eslint/parser": "^8.49.0",
    "tsx": "^4.19.1",
