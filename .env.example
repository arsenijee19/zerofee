APP_URL=http://localhost:3000
NODE_ENV=development
RUNTIME_MODE=development
DATABASE_URL=postgresql://zerofee:zerofee@localhost:55432/zerofee
AUTH_SECRET=dev-only-change-me
CREATOR_PAYMENTS_PROVIDER=mock
PLATFORM_BILLING_PROVIDER=mock
TAX_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
EMAIL_PROVIDER=mock
MEDIA_STORAGE_PROVIDER=local
GUARANTEED_EARNINGS_LIVE_ALLOWED=false

# Email (mock stores mail in the test_mailbox table; resend sends real mail)
EMAIL_FROM=ZeroFee <no-reply@your-domain.com>
RESEND_API_KEY=

# Object storage (local | s3). s3 works with AWS S3, Cloudflare R2, Backblaze B2, MinIO.
MEDIA_LOCAL_DIR=storage/mock
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
